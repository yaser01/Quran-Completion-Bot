# ── Telegram ──────────────────────────────────────────────────────────────────
BOT_TOKEN=

# Webhook — IP-based (no domain required; Telegram allows self-signed certs)
# WEBHOOK_URL must be https:// — Telegram requires HTTPS even with an IP
# Format: https://YOUR_SERVER_IP:8443/webhook
# Note: when first registering the webhook, pass the cert to Telegram:
#   bot.set_webhook(url=WEBHOOK_URL, certificate=open(CERT_PATH, 'rb'))
WEBHOOK_URL=https://YOUR_SERVER_IP:8443/webhook
WEBHOOK_LISTEN_HOST=0.0.0.0
WEBHOOK_LISTEN_PORT=8443
SECRET_TOKEN=

# Paths to TLS key/cert (inside container when using Docker)
PRIVATE_KEY=/app/Secret Files/privkey.pem
CERT=/app/Secret Files/cert.pem

# Channels
QURAN_FILES_CHANNEL_ID=@your_quran_files_channel       # where Quran pages/PDFs are cached
QURAN_DAILY_PAGE_CHANNEL_ID=@your_daily_page_channel   # where the daily page is posted

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
# Local / bare-metal format:
DATABASE_URI=postgresql+asyncpg://user:password@localhost:5432/quranbot
# Docker format (DB_HOST = service name in docker-compose):
# DATABASE_URI=postgresql+asyncpg://${DATABASE_USER}:${DATABASE_PASSWORD}@${DB_HOST}:5432/${POSTGRES_DB}

# ── Backup Service (Database/Backup_Database.py — runs on port 8001) ─────────
DATABASE_BACKUP_URI=http://localhost:8001/backup_database
DEVELOPER_CHAT_ID=                         # Telegram user ID to receive backup error alerts

# ── Google Drive Backup (optional) ───────────────────────────────────────────
GOOGLE_DRIVE_BACKUP_FOLDER_ID=
ENABLE_DRIVE_BACKUP=0                      # set to 1 to enable; requires Secret Files/token.json

# ── Admin Panel (Database/Admin.py — runs on port 8002) ──────────────────────
ADMIN_PAGE_PASSWORD=
ADMIN_SECRET_KEY=change-this-to-a-long-random-secret
ADMIN_PORT=8002

# ── Docker / Postgres (only when using docker-compose) ───────────────────────
POSTGRES_DB=quranbot
DATABASE_USER=quranbot
DATABASE_PASSWORD=changeme
DB_HOST=quranbot_postgres
